<Window x:Class="ProgrammScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program Scanner" Height="760" Width="1750" MinHeight="560" MinWidth="1100"
        Background="#0B0F14" Foreground="#E6E6E6"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="ADBg" Color="#0B0F14"/><SolidColorBrush x:Key="ADPanel" Color="#121922"/><SolidColorBrush x:Key="ADPanel2" Color="#0F151D"/><SolidColorBrush x:Key="ADBorder" Color="#223040"/><SolidColorBrush x:Key="ADBorderSoft" Color="#1A2431"/><SolidColorBrush x:Key="ADText" Color="#E6E6E6"/><SolidColorBrush x:Key="ADTextDim" Color="#9FB0C3"/><SolidColorBrush x:Key="ADAccent" Color="#FF6A00"/><SolidColorBrush x:Key="ADAccent2" Color="#FF8A2A"/><SolidColorBrush x:Key="ADDanger" Color="#FF4D4D"/><SolidColorBrush x:Key="ADInput" Color="#0C1219"/><SolidColorBrush x:Key="ADHover" Color="#1E2A3B"/><SolidColorBrush x:Key="ADSelected" Color="#182231"/><SolidColorBrush x:Key="ADPressed" Color="#0F1621"/><SolidColorBrush x:Key="ADConsoleBg" Color="#070B10"/><SolidColorBrush x:Key="ADConsoleText" Color="#D7E3F1"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource ADPanel}"/><Setter Property="BorderBrush" Value="{StaticResource ADBorderSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource ADText}"/><Setter Property="Background" Value="{StaticResource ADSelected}"/><Setter Property="BorderBrush" Value="{StaticResource ADBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style x:Key="AccentButton" TargetType="Button"><Setter Property="Foreground" Value="#101010"/><Setter Property="Background" Value="{StaticResource ADAccent}"/><Setter Property="BorderBrush" Value="{StaticResource ADAccent2}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="TitleBarButton" TargetType="Button"><Setter Property="Background" Value="#101826"/><Setter Property="Foreground" Value="{StaticResource ADText}"/><Setter Property="MinWidth" Value="46"/><Setter Property="MinHeight" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="8,2"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="TitleBarQuitButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}"><Setter Property="Background" Value="#2A1416"/><Setter Property="BorderBrush" Value="{StaticResource ADDanger}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#FFD7D7"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource ADText}"/><Setter Property="Background" Value="{StaticResource ADInput}"/><Setter Property="BorderBrush" Value="{StaticResource ADBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource ADTextDim}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource ADPanel}"/><Setter Property="Foreground" Value="{StaticResource ADText}"/><Setter Property="BorderBrush" Value="{StaticResource ADBorderSoft}"/><Setter Property="RowBackground" Value="{StaticResource ADPanel}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource ADPanel2}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ADBorderSoft}"/><Setter Property="VerticalGridLinesBrush" Value="{StaticResource ADBorderSoft}"/><Setter Property="RowHeight" Value="34"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource ADPanel2}"/><Setter Property="Foreground" Value="{StaticResource ADTextDim}"/><Setter Property="BorderBrush" Value="{StaticResource ADBorder}"/><Setter Property="Padding" Value="10,8"/></Style>
        <ContextMenu x:Key="BrowserContextMenu" Background="{StaticResource ADPanel2}" Foreground="{StaticResource ADText}"><MenuItem Header="Open in Browser" Click="OpenInBrowserMenuItem_Click"/></ContextMenu>
    </Window.Resources>
    <Grid Background="{StaticResource ADBg}"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource ADPanel2}" BorderBrush="{StaticResource ADBorderSoft}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="{StaticResource ADAccent}" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="PROGRAMM SCANNER" FontWeight="SemiBold"/><TextBlock Text="AirysDark Program Theme" Foreground="{StaticResource ADTextDim}" Margin="12,0,0,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TitleBarButton}" Content="—" Click="MinimizeButton_Click"/><Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="▢" Margin="6,0,0,0" Click="MaximizeRestoreButton_Click"/><Button Style="{StaticResource TitleBarQuitButton}" Content="✕" Margin="6,0,0,0" Click="CloseButton_Click"/></StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="PROGRAM DATA" FontWeight="SemiBold"/><TextBlock Text="Scan installed programs or load a previously exported CSV file." Foreground="{StaticResource ADTextDim}" TextWrapping="Wrap" Margin="0,6,0,12"/><Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Content="Scan Installed Programs" Click="ScanButton_Click" Margin="0,0,0,8"/><Button x:Name="ImportButton" Content="Import CSV" Click="ImportButton_Click"/><Button Content="Export CSV" Click="ExportButton_Click" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ONLINE LOOKUP" FontWeight="SemiBold"/><TextBlock Text="Tick programs in the table, then search the first five web results for a likely website or download." Foreground="{StaticResource ADTextDim}" TextWrapping="Wrap" Margin="0,6,0,12"/><CheckBox x:Name="SelectAllCheckBox" Content="Select All Programs" Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked" Margin="0,0,0,10"/><Button x:Name="FindOnlineCheckedButton" Style="{StaticResource AccentButton}" Content="Find Online for Checked" Click="FindOnlineCheckedButton_Click" Margin="0,0,0,8"/><Button x:Name="FindOnlineButton" Content="Find Online for Selected" Click="FindOnlineButton_Click"/><Button x:Name="OpenWebsiteButton" Content="Open Website" Click="OpenWebsiteButton_Click" Tag="OfficialWebsite" ContextMenu="{StaticResource BrowserContextMenu}" Margin="0,12,0,8"/><Button x:Name="OpenDownloadButton" Content="Open Download" Click="OpenDownloadButton_Click" Tag="DownloadUrl" ContextMenu="{StaticResource BrowserContextMenu}"/></StackPanel></Border></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="INSTALLED PROGRAMS" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Installation details, official websites, and likely download sources." Foreground="{StaticResource ADTextDim}" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search programs, publishers or locations"/></Grid><DataGrid Grid.Row="2" x:Name="ProgramsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="✓" Width="45" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsOnlineSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/><DataGridTextColumn Header="Install Location" Binding="{Binding InstallLocation}" Width="2*"/><DataGridTextColumn Header="Location Source" Binding="{Binding LocationSource}" Width="*"/><DataGridTextColumn Header="Official Website" Binding="{Binding OfficialWebsite}" Width="2*"/><DataGridTextColumn Header="Download Link" Binding="{Binding DownloadUrl}" Width="2*"/><DataGridTextColumn Header="Online Status" Binding="{Binding OnlineStatus}" Width="*"/><DataGridTextColumn Header="Actual Path" Binding="{Binding ActualInstallPath}" Width="2*"/></DataGrid.Columns></DataGrid><Border Grid.Row="3" Background="{StaticResource ADConsoleBg}" BorderBrush="{StaticResource ADBorderSoft}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource ADConsoleText}" FontFamily="Consolas" FontSize="13" Text="Ready to scan." TextWrapping="Wrap"/></Border></Grid></Border></Grid>
    </Grid>
</Window>