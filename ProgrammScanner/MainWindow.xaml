<Window x:Class="ProgrammScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program Scanner" Height="700" Width="1750" MinHeight="500" MinWidth="1100">
    <Window.Resources>
        <ContextMenu x:Key="BrowserContextMenu">
            <MenuItem Header="Open in Browser" Click="OpenInBrowserMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Installed Program Scanner" FontSize="24" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                <Button x:Name="ScanButton" Content="Scan Installed Programs" Width="180" Height="34" Click="ScanButton_Click" />
                <Button x:Name="FindOnlineButton" Content="Find Online for Selected" Width="170" Height="34" Margin="10,0,0,0" Click="FindOnlineButton_Click" />
                <Button x:Name="FindOnlineCheckedButton" Content="Find Online for Checked" Width="175" Height="34" Margin="10,0,0,0" Click="FindOnlineCheckedButton_Click" />
                <CheckBox x:Name="SelectAllCheckBox" Content="Select All" Margin="15,0,0,0"
                          VerticalAlignment="Center" Checked="SelectAllCheckBox_Checked"
                          Unchecked="SelectAllCheckBox_Unchecked" />
                <Button x:Name="OpenWebsiteButton" Content="Open Website" Width="110" Height="34" Margin="10,0,0,0" Click="OpenWebsiteButton_Click"
                        Tag="OfficialWebsite" ContextMenu="{StaticResource BrowserContextMenu}" />
                <Button x:Name="OpenDownloadButton" Content="Open Download" Width="120" Height="34" Margin="10,0,0,0" Click="OpenDownloadButton_Click"
                        Tag="DownloadUrl" ContextMenu="{StaticResource BrowserContextMenu}" />
                <TextBox x:Name="SearchBox" Width="220" Height="34" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                         ToolTip="Search programs, publishers or locations" />
                <Button Content="Export CSV" Width="100" Height="34" Margin="10,0,0,0" Click="ExportButton_Click" />
                <TextBlock x:Name="StatusText" Margin="15,8,0,0" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ProgramsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Column.Header}" Value="Official Website">
                            <Setter Property="ContextMenu" Value="{StaticResource BrowserContextMenu}" />
                            <Setter Property="Tag" Value="OfficialWebsite" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Column.Header}" Value="Download Link">
                            <Setter Property="ContextMenu" Value="{StaticResource BrowserContextMenu}" />
                            <Setter Property="Tag" Value="DownloadUrl" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="45" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsOnlineSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                <DataGridTextColumn Header="Install Location" Binding="{Binding InstallLocation}" Width="2*" />
                <DataGridTextColumn Header="Location Source" Binding="{Binding LocationSource}" Width="*" />
                <DataGridTextColumn Header="Official Website" Binding="{Binding OfficialWebsite}" Width="2*" />
                <DataGridTextColumn Header="Download Link" Binding="{Binding DownloadUrl}" Width="2*" />
                <DataGridTextColumn Header="Online Status" Binding="{Binding OnlineStatus}" Width="*" />
                <DataGridTextColumn Header="Actual Path" Binding="{Binding ActualInstallPath}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
